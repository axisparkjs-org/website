# Image of the website: the static site generated by `npm run build` served by nginx.
#
# The site is not built inside the image because the API reference needs a checkout of axispark
# (see README.md). Build the site first and then the image from the root of the repository:
#
#   npm run build
#   docker build -f docker/Dockerfile -t axisparkjs-website .
FROM nginx:1.29-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY build/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
